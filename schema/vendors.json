{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vendors",
  "title": "Vendors Collection",
  "description": "Master list of vegetable suppliers / wholesale vendors. Collection: vendors. Document ID: Firestore auto-generated.",
  "type": "object",
  "required": ["name", "phone", "area", "active", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Firestore auto-generated document ID"
    },
    "name": {
      "type": "string",
      "description": "Vendor/supplier full name"
    },
    "phone": {
      "type": "string",
      "pattern": "^[6-9]\\d{9}$",
      "description": "10-digit Indian mobile number"
    },
    "area": {
      "type": "string",
      "description": "Area or locality where vendor operates (e.g. Darsi Market, Ongole APMC)"
    },
    "address": {
      "type": "string",
      "description": "Full address (optional)"
    },
    "vegetables_supplied": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of veg_ids this vendor typically supplies"
    },
    "payment_terms": {
      "type": "string",
      "enum": ["daily_cash", "weekly_credit", "monthly_credit"],
      "description": "Agreed payment terms with the vendor",
      "default": "daily_cash"
    },
    "active": {
      "type": "boolean",
      "description": "Whether this vendor is currently active",
      "default": true
    },
    "notes": {
      "type": "string",
      "description": "Any additional notes about this vendor"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Firestore Timestamp — when vendor was added"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Firestore Timestamp — last updated"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "name": "Raju Vegetables",
      "phone": "9876543210",
      "area": "Darsi Market",
      "payment_terms": "daily_cash",
      "active": true,
      "created_at": "2026-06-20T00:00:00Z",
      "updated_at": "2026-06-20T00:00:00Z"
    }
  ]
}
