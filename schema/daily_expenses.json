{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "daily_expenses",
  "title": "Daily Expenses Collection",
  "description": "Daily operational expenses — fuel, transport, bags, labour. Used to compute real net profit. Collection: daily_expenses. Document ID: Firestore auto-generated.",
  "type": "object",
  "required": ["expense_date", "type", "amount", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Firestore auto-generated document ID"
    },
    "expense_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of expense in YYYY-MM-DD format",
      "example": "2026-06-20"
    },
    "type": {
      "type": "string",
      "description": "Expense category shown in Analytics UI",
      "examples": ["⛽ ఇంధనం", "🛍 సంచులు", "👷 కూలి", "📦 రవాణా", "🔧 ఇతర"]
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Expense amount in INR"
    },
    "note": {
      "type": "string",
      "description": "Optional free-text note (e.g. '2 litres petrol')"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Firestore Timestamp — when expense was recorded"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "expense_date": "2026-06-20",
      "type": "⛽ ఇంధనం",
      "amount": 120,
      "note": "2 లీటర్ పెట్రోల్",
      "created_at": "2026-06-20T07:30:00Z"
    },
    {
      "expense_date": "2026-06-20",
      "type": "🛍 సంచులు",
      "amount": 50,
      "note": "",
      "created_at": "2026-06-20T08:00:00Z"
    }
  ]
}
