{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "daily_summary",
  "title": "Daily Summary Collection",
  "description": "End-of-day financial and stock summary. One document per day. Collection: daily_summary. Document ID: YYYY-MM-DD (e.g. '2026-06-20').",
  "type": "object",
  "required": ["date", "total_sales_amount", "total_buy_amount", "gross_profit", "total_transactions", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Document ID = date in YYYY-MM-DD format"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Summary date",
      "example": "2026-06-20"
    },
    "total_sales_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Sum of all sales.total_amount for this date (in INR)"
    },
    "total_buy_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Sum of all vendor_orders.total_amount for this date (in INR)"
    },
    "gross_profit": {
      "type": "number",
      "description": "total_sales_amount - total_buy_amount (in INR)"
    },
    "gross_profit_pct": {
      "type": "number",
      "description": "(gross_profit / total_buy_amount) × 100"
    },
    "total_transactions": {
      "type": "number",
      "minimum": 0,
      "description": "Total number of sale transactions for this date"
    },
    "total_wastage_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated value of stock logged as wastage today"
    },
    "payment_breakdown": {
      "type": "object",
      "description": "Sales amount split by payment mode",
      "properties": {
        "cash": { "type": "number", "minimum": 0 },
        "upi": { "type": "number", "minimum": 0 },
        "credit": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "vegetables_sold": {
      "type": "array",
      "description": "Per-vegetable sales breakdown for this day",
      "items": {
        "type": "object",
        "required": ["veg_id", "veg_name_en", "quantity_sold", "unit", "revenue"],
        "properties": {
          "veg_id": { "type": "string" },
          "veg_name_en": { "type": "string" },
          "veg_name_te": { "type": "string" },
          "quantity_sold": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" },
          "revenue": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "top_seller": {
      "type": "string",
      "description": "veg_name_en of the best-selling vegetable by revenue today"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "finalized"],
      "description": "draft = day still in progress, finalized = EOD summary locked",
      "default": "draft"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Firestore Timestamp — when summary was first created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Firestore Timestamp — last recalculated"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "2026-06-20",
      "date": "2026-06-20",
      "total_sales_amount": 4250,
      "total_buy_amount": 2800,
      "gross_profit": 1450,
      "gross_profit_pct": 51.79,
      "total_transactions": 38,
      "total_wastage_amount": 120,
      "payment_breakdown": {
        "cash": 3100,
        "upi": 950,
        "credit": 200
      },
      "vegetables_sold": [
        {
          "veg_id": "abc123",
          "veg_name_en": "Tomato",
          "veg_name_te": "టమాట",
          "quantity_sold": 42,
          "unit": "kg",
          "revenue": 1470
        }
      ],
      "top_seller": "Tomato",
      "status": "finalized",
      "created_at": "2026-06-20T08:00:00Z",
      "updated_at": "2026-06-20T20:00:00Z"
    }
  ]
}
