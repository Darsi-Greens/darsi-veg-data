{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sales",
  "title": "Sales Transactions Collection",
  "description": "Individual sale transactions — one document per line item sold. Collection: sales. Document ID: Firestore auto-generated.",
  "type": "object",
  "required": [
    "veg_id", "veg_name_en", "veg_name_te", "sale_date",
    "quantity", "unit", "sell_price", "total_amount",
    "payment_mode", "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Firestore auto-generated document ID"
    },
    "veg_id": {
      "type": "string",
      "description": "Reference to vegetables/{id}"
    },
    "veg_name_en": {
      "type": "string",
      "description": "Denormalized vegetable name in English"
    },
    "veg_name_te": {
      "type": "string",
      "description": "Denormalized vegetable name in Telugu"
    },
    "veg_emoji": {
      "type": "string",
      "description": "Denormalized emoji for receipt display"
    },
    "sale_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Sale date in YYYY-MM-DD format for grouping/filtering",
      "example": "2026-06-20"
    },
    "quantity": {
      "type": "number",
      "minimum": 0.01,
      "description": "Quantity sold (supports decimals for kg)"
    },
    "unit": {
      "type": "string",
      "enum": ["kg", "bundle", "piece", "dozen"],
      "description": "Unit of measure for this sale"
    },
    "sell_price": {
      "type": "number",
      "minimum": 0,
      "description": "Price per unit at time of sale (in INR)"
    },
    "total_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Total sale amount = quantity × sell_price (in INR)"
    },
    "payment_mode": {
      "type": "string",
      "enum": ["cash", "upi", "credit"],
      "description": "How the customer paid"
    },
    "customer_name": {
      "type": "string",
      "description": "Optional customer name (for credit sales)"
    },
    "customer_phone": {
      "type": "string",
      "description": "Optional customer phone (for credit sales)"
    },
    "notes": {
      "type": "string",
      "description": "Optional free-text note on the transaction"
    },
    "credit_paid": {
      "type": "boolean",
      "description": "For credit sales: true once customer has paid. Default false.",
      "default": false
    },
    "credit_paid_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Firestore Timestamp — when credit was collected (null until paid)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Firestore Timestamp — exact time of sale"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "veg_id": "abc123",
      "veg_name_en": "Tomato",
      "veg_name_te": "టమాట",
      "veg_emoji": "🍅",
      "sale_date": "2026-06-20",
      "quantity": 2.5,
      "unit": "kg",
      "sell_price": 35,
      "total_amount": 87.5,
      "payment_mode": "cash",
      "created_at": "2026-06-20T09:30:00Z"
    }
  ]
}
